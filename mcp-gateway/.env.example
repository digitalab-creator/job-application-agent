MCP_GATEWAY_PORT=3101
MCP_GATEWAY_BIND_HOST=127.0.0.1
JOBAGENT_MCP_ACCESS_TOKEN=generate-a-long-random-token
JOBAGENT_API_TOKEN=same-as-APPLY_API_TOKEN
JOBAGENT_API_BASE_URL=http://127.0.0.1:3099
# Required. Must use jobagent_mcp_readonly (see scripts/postgres/create-mcp-readonly-role.sql).
JOBAGENT_MCP_DATABASE_URL=postgres://jobagent_mcp_readonly:REPLACE@127.0.0.1:5433/jobagent
JOBAGENT_DEFAULT_WORKSPACE_ID=internal
JOBAGENT_GITHUB_REPO=digitalab-creator/job-application-agent
GITHUB_TOKEN=optional-for-release-status-tool
MCP_GATEWAY_AUDIT_LOG=/app/data/ledger/mcp-gateway-audit.jsonl
