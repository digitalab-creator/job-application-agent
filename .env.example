PORT=3000
APPLY_API_TOKEN=replace-me
# Platform cutover flag only. Customer sheet, mailbox, profile, and budget live on the workspace row.
# native = this repo's scheduler. n8n = temporary shared server. Do not put a buyer name or sheet id here.
ORCHESTRATION_MODE=native
# Set false to run the API/browser on demand only (no daily discover/apply/outcome).
NATIVE_SCHEDULER_ENABLED=true
# MCP gateway (profile mcp): readonly Postgres role — see scripts/postgres/create-mcp-readonly-role.sql
# JOBAGENT_MCP_READONLY_PASSWORD=
# JOBAGENT_MCP_DATABASE_URL=postgres://jobagent_mcp_readonly:PASSWORD@workspace-db:5432/jobagent
# Native mode only — Postgres URL (see docker compose profile `native`).
# WORKSPACE_DATABASE_URL=postgres://jobagent:jobagent@workspace-db:5432/jobagent
# PLATFORM_ENCRYPTION_KEY=64-hex-chars-or-any-secret-string
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Per-workspace run token (seed script); not the operator APPLY_API_TOKEN.
# WORKSPACE_INTERNAL_RUN_TOKEN=
# WORKSPACE_INTERNAL_GOOGLE_REFRESH_TOKEN=   # Sheets OAuth refresh token
# WORKSPACE_INTERNAL_MAILBOX_REFRESH_TOKEN=  # Gmail OAuth refresh token (OTP)
# WORKSPACE_INTERNAL_MAILBOX_EMAIL=redacted@example.com
TECHNICAL_CV_PATH=/app/data/cv/technical-cv.pdf
MARKETING_CV_PATH=/app/data/cv/marketing-cv.pdf
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra
LLM_CV_MODEL=gpt-5.6-sol
TZ=Asia/Jerusalem
BROWSER_PERSISTENT_PROFILE=true
BROWSER_APPLY_HEADLESS=false
BROWSER_USER_DATA_DIR=/app/data/browser-profile
BROWSER_SLOW_MO_MS=80
BROWSER_TIMEZONE=Asia/Jerusalem
# Daily spend gate: monthly remaining ILS ÷ days left in month (see budgetSnapshot). Apply runs until
# daily allowance is spent or no eligible New rows. Costs tracked in COST_LEDGER_PATH (100% of LLM calls).
# Optional legacy fuse — off by default (set APPLY_USE_ATTEMPT_QUOTA=true to enforce).
DAILY_APPLY_MAX_ATTEMPTS=1000
# Sizes each pick batch: floor(dailyRemainingIls / estimate). Not a daily stop target.
ESTIMATED_APPLY_COST_ILS=1
# APPLY_USE_ATTEMPT_QUOTA=false
# APPLY_PICK_BATCH_SAFETY_CAP=500
# Optional JSONL path for one terminal outcome per worker attempt.
# APPLY_ATTEMPTS_PATH=/app/data/ledger/apply-attempts.jsonl
# Optional bootstrap only when data/config/excluded-companies.json is missing.
# Admin SSOT is Google Sheet tab "Exclude Companies" (synced by n8n each apply run).
# APPLY_EXCLUDED_COMPANIES=בורודה קפלן,k-logic,two-solutions,Hunt
# APPLY_EXCLUDED_COMPANIES_PATH=/app/data/config/excluded-companies.json
# Blocked cities: the ONE source of truth is data/config/excluded-locations.json (no env/code/sheet copy).
# Edit that file or PUT /config/excluded-locations. Override the path only for tests.
# APPLY_EXCLUDED_LOCATIONS_PATH=/app/data/config/excluded-locations.json
# Disk cache for location lookups (rules / page fetch / LLM web search). One entry per job URL.
# LOCATION_VERDICT_CACHE_PATH=/app/data/cache/location-verdicts.json
# When true, use OpenAI Responses web_search_preview for uncertain Israeli jobs (falls back to chat if unavailable).
# LOCATION_LOOKUP_WEB_SEARCH=true
# Shared monthly cap for discovery + apply (ILS). LLM + manual n8n costs only unless fixed cost is set.
MONTHLY_BUDGET_ILS=500
MONTHLY_FIXED_COST_ILS=0
USD_ILS_RATE=3.65
# Legacy bootstrap for workspace seed only — store boards on the workspace row after cutover.
# JOB_DISCOVERY_BOARD_URLS=
DISCOVERY_MAX_JOBS_PER_BOARD=12
DISCOVERY_MAX_JOBS_PER_RUN=20
# Optional override for coarse tech/marketing rebalance (0–1). Per-category targets SSOT: src/discovery/tracker-categories.ts (~0.65 marketing).
# QUEUE_MIX_MARKETING_SHARE=0.65
# Greenhouse email OTP: n8n workflow greenhouse-apply-otp (Bearer = APPLY_API_TOKEN).
GREENHOUSE_OTP_WEBHOOK_URL=http://n8n:5678/webhook/greenhouse-apply-otp
GREENHOUSE_OTP_TIMEOUT_MS=120000
GREENHOUSE_OTP_POLL_INTERVAL_MS=5000
# LinkedIn Easy Apply is off unless this is exactly true. Off means the browser never opens LinkedIn.
LINKEDIN_EASY_APPLY_ENABLED=false
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=
# LINKEDIN_EASY_APPLY_DAILY_MAX=10
# AGGREGATOR_ATTEMPT_SLOTS=5
# CAPTCHA: try Buster (https://github.com/dessant/buster) in the browser first; 2captcha only if that fails.
# CAPTCHA_BUSTER_ENABLED=true
# BUSTER_EXTENSION_PATH=/app/vendor/buster
# CAPTCHA_SOLVER_API_KEY=
# CAPTCHA_MAX_ILS_PER_JOB=2
# 2captcha spend is recorded in costs.jsonl and counts toward MONTHLY_BUDGET_ILS (same pool as LLM).
# CAPTCHA_2CAPTCHA_COST_ILS=0.35
# CAPTCHA_SOLVER_STATS_PATH=/app/data/ledger/captcha-solver-stats.json
# BUSTER_VERSION=3.4.0
# GITHUB_TOKEN — server SSOT only: /opt/apps/n8n/.env (never commit). Load before gh/git/compose:
#   source scripts/load-github-token.sh && load_server_github_token
# Fine-grained PAT on this repo: Contents + Pull requests + Actions (read; Actions write for Deploy dispatch).
# Used for github-evidence (optional), MCP release-status tool, and kit commit-dev / handle-pull-request.
# GITHUB_EVIDENCE_REPOS=digitalab-creator/legal-ai
# Optional USD per 1M tokens. Leave unset to use the built-in OpenAI rates for Sol, Terra, and Luna.
# LLM_PRICES_JSON={"gpt-5.6-sol":{"input":4,"cachedInput":0.4,"output":20},"gpt-5.6-terra":{"input":2,"cachedInput":0.2,"output":12},"gpt-5.6-luna":{"input":0.2,"cachedInput":0.02,"output":1.2}}
# Freelance packs + self digest (draft written to data/freelance-packs/latest-digest-preview.txt).
# FREELANCE_PACKS_PER_DAY=3
# FREELANCE_DIGEST_TO=redacted@example.com
# FREELANCE_DIGEST_SEND=false
# FREELANCE_DIGEST_SUBJECT=Freelance packs ready
# Greenhouse navigation caps (per target URL attempts + max error=true signals per openJob).
# GREENHOUSE_NAV_ATTEMPTS_PER_URL=2
# GREENHOUSE_NAV_MAX_ERROR_SIGNALS=4
