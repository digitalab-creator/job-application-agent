PORT=3000
APPLY_API_TOKEN=replace-me
TECHNICAL_CV_PATH=/app/data/cv/technical-cv.pdf
MARKETING_CV_PATH=/app/data/cv/marketing-cv.pdf
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra
LLM_CV_MODEL=gpt-5.6-sol
TZ=Asia/Jerusalem
BROWSER_PERSISTENT_PROFILE=true
BROWSER_APPLY_HEADLESS=false
BROWSER_USER_DATA_DIR=/app/data/browser-profile
BROWSER_SLOW_MO_MS=80
BROWSER_TIMEZONE=Asia/Jerusalem
# How many finished attempts count per Jerusalem day. A 404 or removed job does not count.
DAILY_APPLY_LIMIT=20
# Optional USD per 1M tokens. Leave unset to use the built-in OpenAI rates for Sol, Terra, and Luna.
# LLM_PRICES_JSON={"gpt-5.6-sol":{"input":4,"cachedInput":0.4,"output":20},"gpt-5.6-terra":{"input":2,"cachedInput":0.2,"output":12},"gpt-5.6-luna":{"input":0.2,"cachedInput":0.02,"output":1.2}}
