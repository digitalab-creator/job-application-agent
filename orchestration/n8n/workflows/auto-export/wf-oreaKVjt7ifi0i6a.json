    {
      "id": "c7c8910b-ac81-490d-bad0-df2adbf0351c",
      "name": "Collect URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map((item) => item.json);\nconst existingUrls = rows.map((row) => String(row['Job URL'] || '').trim()).filter(Boolean);\n\nconst TECH = new Set([\n  'Applied AI', 'AI Product', 'AI Solutions', 'Growth Engineering', 'Digital Operations', 'Marketing Technology',\n]);\nconst MKT = new Set([\n  'Growth Marketing', 'Performance Marketing Leadership', 'Analytics & CRO', 'Product-led Growth', 'Revenue Systems',\n]);\n\nlet tech = 0;\nlet marketing = 0;\nfor (const row of rows) {\n  if (String(row.Status || '').trim() !== 'New') continue;\n  const cat = String(row.Category || '').trim();\n  if (TECH.has(cat)) tech += 1;\n  else if (MKT.has(cat)) marketing += 1;\n}\nconst total = tech + marketing;\nconst techPct = total > 0 ? (tech / total) * 100 : 65;\n\nreturn [{\n  json: {\n    existingUrls,\n    newQueueStats: { tech, marketing, total, techPct, statusNew: rows.filter((row) => String(row.Status || '').trim() === 'New').length },\n  },\n}];"
      }
    },
    {
      "id": "33176789-765b-4dd6-ba42-c1114bb605da",
      "name": "Scan Boards",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://job-application-agent:3000/discover/scan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ existingUrls: $json.existingUrls || [], newQueueStats: $json.newQueueStats }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "AdigSJxrIRyVjF5h",
          "name": "Job application worker"
        }
      }
    },
    {
      "id": "e210fc92-b6ee-400b-b696-661b0feb1a4c",
      "name": "Expand Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        0
      ],
      "parameters": {
        "jsCode": "const res = $json || {};\nconst jobs = Array.isArray(res.jobs) ? res.jobs : [];\nif (jobs.length === 0) {\n  return [{ json: { skip: true, notes: res.notes || 'No new jobs.', mixReport: res.mixReport || '' } }];\n}\nconst header = res.mixReport ? `AUTO_DISCOVER\\n${res.mixReport}` : 'AUTO_DISCOVER';\nreturn jobs.map((job) => ({ json: {\n  'Unique Key': job.uniqueKey,\n  'Found Date': job.foundDate,\n  Role: job.role,\n  Company: job.company,\n  Category: job.category,\n  'Match Score': job.matchScore,\n  'Why It Fits': job.whyItFits,\n  Source: job.source,\n  Location: job.location || '',\n  'Job URL': job.url,\n  Status: 'New',\n  Notes: `${header}\\n${res.notes || ''}`.trim(),\n} }));"
      }
    },
