{
  "name": "opportunity-pipeline-apps-script",
  "version": "1.0.0",
  "private": true,
  "description": "clasp workspace for the daily Job + Freelance opportunity pipeline",
  "scripts": {
    "login": "clasp login",
    "logout": "clasp logout",
    "pull": "clasp pull",
    "status": "clasp status",
    "push": "clasp push",
    "open": "clasp open",
    "logs": "clasp logs",
    "check": "node scripts/check-setup.js",
    "deploy-help": "node scripts/deploy-checklist.js",
    "create-bound": "node -e \"const id=process.env.WORKSPACE_INTERNAL_SPREADSHEET_ID;if(!id){console.error('Set WORKSPACE_INTERNAL_SPREADSHEET_ID');process.exit(1)}\" && clasp create --type sheets --title \"Opportunity Pipeline\" --rootDir ./src --parentId \"$WORKSPACE_INTERNAL_SPREADSHEET_ID\"",
    "test": "node --test tests/**/*.test.js",
    "backfill": "node scripts/backfill-sheet-local.js"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0"
  }
}
